{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Typo Scanner",
  "version": "0.1.0",
  "identifier": "codes.typo.typo-scanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Typo Scanner",
        "width": 1200,
        "height": 850,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["typoscan"],
        "name": "Typo Scanner Project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "codes.typo.typo-scanner.project",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
